  m_Script: {fileID: 11500000, guid: 532fe926c7aac1b438cb9b71cd19eaf9, type: 3}
  m_Name: Widemouth
  m_EditorClassIdentifier: Assembly-CSharp::CreatureData
  creatureName: Widemouth
  description: "A forest predator that likes to climb, burrow or run chasing smaller
    prey. It can\u2019t talk, but it has apparently learned a few words that it uses
    to lure people into natural traps so it can feast on their corpses. The way to
    differentiate it from someone in danger in the woods is the constant giggling
    it makes.\r\n"
  note: "The red eyes and yellow teeth are kinda scary, but the worst part is that
    the Widemouth is so annoying! It\u2019s constantly trying to get me to hurt myself
    by bringing me knives and opening windows, like it\u2019s telling me to jump.\r\n"
  family: 3
  favoriteScent: 3
  hatedScent: 0
